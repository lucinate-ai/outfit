# Secrets — contains the OpenRouter API key
.env

# Compiled binary (`go build -o outfit .`, or the default `go build .` name)
/outfit

# GoReleaser output
/dist/

# The binary examples/fleet-docker/run-tests.sh builds to drive the example
# fleet. `go test ./...` runs that script, so anyone running the suite finds a
# 15MB executable sitting untracked in the working tree.
/examples/fleet-docker/.outfit-test-bin

# Coverage artefacts
coverage.out
coverage.html

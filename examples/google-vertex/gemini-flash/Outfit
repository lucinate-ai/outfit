# Gemini 2.0 Flash on GCP Vertex AI.
# No API key: the Vertex SDK reads your Google Application Default Credentials.
# Set GOOGLE_VERTEX_PROJECT (required) and optionally GOOGLE_VERTEX_LOCATION
# (defaults to `global`). See the README.
PROVIDER google-vertex
MODEL    gemini-2.0-flash   # the Vertex Gemini model id opencode calls
CONTEXT  1m
OUTPUT   8k

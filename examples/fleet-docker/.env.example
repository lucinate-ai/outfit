# Copy to .env beside fleet.yaml, then `docker compose up -d --build`.
#
# Each value is the OUTFIT_API_TOKEN of that node's daemon: compose passes it
# into the container, and fleet.yaml references the same variable by name so
# the client authenticates with it. Any non-empty values work — these are
# example tokens for a local stack, not secrets.
STUDIO_TOKEN=studio-dev-token
GPU_BOX_TOKEN=gpu-box-dev-token
LAPTOP_TOKEN=laptop-dev-token

# studio's engine is gated with this. Unlike the tokens above it is never
# passed to the container: the client sends it when it starts the engine, so
# only this side holds it.
STUDIO_ENGINE_KEY=studio-engine-dev-key

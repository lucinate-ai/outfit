{
  "name": "cloud-vm-llm",
  "version": "0.1.0",
  "private": true,
  "description": "Scale-to-zero self-hosted Qwen3.6-27B endpoint on AWS (vLLM on EC2, CDK)",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc --noEmit",
    "set-ip": "bash scripts/set-ip",
    "test": "vitest run",
    "synth": "cdk synth",
    "deploy:image": "cdk deploy cloud-vm-llm-image",
    "bake": "bash scripts/bake",
    "console": "bash scripts/console",
    "seed-model": "node scripts/seed-model.mjs",
    "seed-deploy-config": "node scripts/seed-deploy-config.mjs",
    "deploy": "cdk deploy cloud-vm-llm --outputs-file cdk-outputs.json && node scripts/write-config.mjs && node scripts/seed-deploy-config.mjs",
    "write-config": "node scripts/write-config.mjs",
    "cdk": "cdk"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.700.0",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.170.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
